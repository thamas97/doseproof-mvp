ne\" stroke=\"#b39263\" stroke-width=\"2\" stroke-dasharray=\"5 5\"/>\n<rect x=\"624\" y=\"174\" width=\"216\" height=\"115\" rx=\"14\" fill=\"#112739\" stroke=\"#2a4960\"/>\n<text x=\"640\" y=\"199\" font-family=\"Segoe UI,Arial,sans-serif\" font-size=\"14\" font-weight=\"700\" fill=\"#6ae6d9\">SENSOR A  /  VIRTUAL</text>\n<g id=\"VAL_dp_sensor_a\" type=\"svg-ext-value\">\n<text x=\"640\" y=\"237\" font-family=\"Segoe UI,Arial,sans-serif\" font-size=\"28\" font-weight=\"700\" fill=\"#f1f8ff\">&#8212;</text>\n</g>\n<text x=\"769\" y=\"236\" font-family=\"Segoe UI,Arial,sans-serif\" font-size=\"14\" font-weight=\"500\" fill=\"#b4cbdc\">mg/L</text>\n<g id=\"VAL_dp_a_state\" type=\"svg-ext-value\">\n<text x=\"640\" y=\"269\" font-family=\"Segoe UI,Arial,sans-serif\" font-size=\"15\" font-weight=\"700\" fill=\"#f6d699\">&#8212;</text>\n</g>\n<rect x=\"860\" y=\"174\" width=\"216\" height=\"115\" rx=\"14\" fill=\"#112739\" stroke=\"#2a4960\"/>\n<text x=\"876\" y=\"199\" font-family=\"Segoe UI,Arial,sans-serif\" font-size=\"14\" font-weight=\"700\" fill=\"#a8c8ff\">SENSOR B  /  VIRTUAL</text>\n<g id=\"VAL_dp_sensor_b\" type=\"svg-ext-value\">\n<text x=\"876\" y=\"237\" font-family=\"Segoe UI,Arial,sans-serif\" font-size=\"28\" font-weight=\"700\" fill=\"#f1f8ff\">&#8212;</text>\n</g>\n<text x=\"1005\" y=\"236\" font-family=\"Segoe UI,Arial,sans-serif\" font-size=\"14\" font-weight=\"500\" fill=\"#b4cbdc\">mg/L</text>\n<g id=\"VAL_dp_b_state\" type=\"svg-ext-value\">\n<text x=\"876\" y=\"269\" font-family=\"Segoe UI,Arial,sans-serif\" font-size=\"15\" font-weight=\"700\" fill=\"#f6d699\">&#8212;</text>\n</g>\n<rect x=\"988\" y=\"349\" width=\"235\" height=\"89\" rx=\"14\" fill=\"#112739\" stroke=\"#2a4960\"/>\n<text x=\"1004\" y=\"375\" font-family=\"Segoe UI,Arial,sans-serif\" font-size=\"14\" font-weight=\"700\" fill=\"#65d9e3\">04  /  WATER OUTLET</text>\n<text x=\"1004\" y=\"401\" font-family=\"Segoe UI,Arial,sans-serif\" font-size=\"16\" font-weight=\"600\" fill=\"#e4eff7\">Simulated treated water</text>\n<path d=\"M1103 438v28\" stroke=\"#78a3b9\" stroke-width=\"2\" stroke-dasharray=\"4 4\"/>\n<rect x=\"670\" y=\"563\" width=\"260\" height=\"91\" rx=\"14\" fill=\"#112739\" stroke=\"#2a4960\"/>\n<text x=\"687\" y=\"588\" font-family=\"Segoe UI,Arial,sans-serif\" font-size=\"14\" font-weight=\"700\" fill=\"#65d9e3\">03  /  MODELED RESIDUAL</text>\n<g id=\"VAL_dp_residual\" type=\"svg-ext-value\">\n<text x=\"687\" y=\"630\" font-family=\"Segoe UI,Arial,sans-serif\" font-size=\"28\" font-weight=\"700\" fill=\"#f1f8ff\">&#8212;</text>\n</g>\n<text x=\"851\" y=\"628\" font-family=\"Segoe UI,Arial,sans-serif\" font-size=\"14\" font-weight=\"500\" fill=\"#b4cbdc\">mg/L</text>\n<rect x=\"288\" y=\"564\" width=\"283\" height=\"90\" rx=\"14\" fill=\"#112739\" stroke=\"#2a4960\"/>\n<text x=\"304\" y=\"589\" font-family=\"Segoe UI,Arial,sans-serif\" font-size=\"14\" font-weight=\"700\" fill=\"#f7c47d\">CONTROLLER ACCEPTED FEED</text>\n<g id=\"VAL_dp_accepted\" type=\"svg-ext-value\">\n<text x=\"304\" y=\"630\" font-family=\"Segoe UI,Arial,sans-serif\" font-size=\"28\" font-weight=\"700\" fill=\"#f1f8ff\">&#8212;</text>\n</g>\n<text x=\"422\" y=\"628\" font-family=\"Segoe UI,Arial,sans-serif\" font-size=\"15\" font-weight=\"500\" fill=\"#b4cbdc\">mg/s setting</text>\n<rect x=\"986\" y=\"547\" width=\"237\" height=\"107\" rx=\"14\" fill=\"#112739\" stroke=\"#2a4960\"/>\n<text x=\"1002\" y=\"572\" font-family=\"Segoe UI,Arial,sans-serif\" font-size=\"14\" font-weight=\"700\" fill=\"#97b7cc\">SIMULATION STEP</text>\n<g id=\"VAL_dp_step\" type=\"svg-ext-value\">\n<text x=\"1002\" y=\"608\" font-family=\"Segoe UI,Arial,sans-serif\" font-size=\"25\" font-weight=\"700\" fill=\"#f1f8ff\">&#8212;</text>\n</g>\n<text x=\"1002\" y=\"635\" font-family=\"Segoe UI,Arial,sans-serif\" font-size=\"14\" font-weight=\"500\" fill=\"#b4cbdc\">Plant data</text>\n<g id=\"VAL_dp_plant_state\" type=\"svg-ext-value\">\n<text x=\"1092\" y=\"635\" font-family=\"Segoe UI,Arial,sans-serif\" font-size=\"15\" font-weight=\"700\" fill=\"#f6d699\">&#8212;</text>\n</g>\n<path d=\"M50 580h31\" stroke=\"#4bd2df\" stroke-width=\"5\" stroke-linecap=\"round\"/><path d=\"M50 607h31\" stroke=\"#f5b652\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n<text x=\"95\" y=\"585\" font-family=\"Segoe UI,Arial,sans-serif\" font-size=\"14\" font-weight=\"500\" fill=\"#b4cbdc\">Water flow</text>\n<text x=\"95\" y=\"612\" font-family=\"Segoe UI,Arial,sans-serif\" font-size=\"14\" font-weight=\"500\" fill=\"#b4cbdc\">Chlorine feed</text>\n<text x=\"47\" y=\"724\" font-family=\"Segoe UI,Arial,sans-serif\" font-size=\"15\" font-weight=\"500\" fill=\"#b4cbdc\">A and B sample the same modeled water through separate virtual sensors. Source status applies to the displayed value.</text>\n<text x=\"991\" y=\"724\" font-family=\"Segoe UI,Arial,sans-serif\" font-size=\"15\" font-weight=\"650\" fill=\"#81b3c9\">Educational simulation</text>\n</svg>",

        "svgcontent": "<svg width=\"1280\" height=\"760\" viewBox=\"0 0 1280 760\" xmlns=\"http://www.w3.org/2000/svg\">\n<defs>\n <linearGradient id=\"dp_bg\" x2=\"0\" y2=\"1\"><stop stop-color=\"#142c40\"/><stop offset=\"1\" stop-color=\"#091724\"/></linearGradient>\n <linearGradient id=\"dp_metal\"><stop stop-color=\"#244c66\"/><stop offset=\".25\" stop-color=\"#82a4b7\"/><stop offset=\".58\" stop-color=\"#476d85\"/><stop offset=\"1\" stop-color=\"#1e3b53\"/></linearGradient>\n <linearGradient id=\"dp_water\" x2=\"0\" y2=\"1\"><stop stop-color=\"#24bbb9\"/><stop offset=\"1\" stop-color=\"#0b748c\"/></linearGradient>\n <linearGradient id=\"dp_pump\" x2=\"1\" y2=\"1\"><stop stop-color=\"#61b7e6\"/><stop offset=\".55\" stop-color=\"#225b92\"/><stop offset=\"1\" stop-color=\"#103451\"/></linearGradient>\n <pattern id=\"dp_grid\" width=\"32\" height=\"32\" patternUnits=\"userSpaceOnUse\"><path d=\"M0 32V0H32\" fill=\"none\" stroke=\"#32495b\" stroke-opacity=\".34\"/></pattern>\n</defs>\n<rect width=\"1280\" height=\"760\" fill=\"#091724\"/>\n<rect x=\"22\" y=\"115\" width=\"1236\" height=\"571\" rx=\"20\" fill=\"url(#dp_bg)\" stroke=\"#314b61\"/>\n<rect x=\"23\" y=\"116\" width=\"1234\" height=\"569\" rx=\"20\" fill=\"url(#dp_grid)\"/>\n<rect x=\"32\" y=\"28\" width=\"4\" height=\"59\" rx=\"2\" fill=\"#51ddcf\"/>\n\n<text x=\"50\" y=\"40\" font-family=\"Segoe UI,Arial,sans-serif\" font-size=\"14\" font-weight=\"700\" fill=\"#61decf\">DOSEPROOF   /   SCADA PROCESS VIEW</text>\n<text x=\"48\" y=\"79\" font-family=\"Segoe UI,Arial,sans-serif\" font-size=\"38\" font-weight=\"700\" fill=\"#f4f8fc\">Chlorine treatment line</text>\n<rect x=\"985\" y=\"32\" width=\"264\" height=\"47\" rx=\"23\" fill=\"#142b3b\" stroke=\"#305266\"/>\n<circle cx=\"1010\" cy=\"55\" r=\"5\" fill=\"#58d7c6\"/>\n<text x=\"1025\" y=\"60\" font-family=\"Segoe UI,Arial,sans-serif\" font-size=\"14\" font-weight=\"700\" fill=\"#dcebf5\">SIMULATION  /  READ ONLY</text>\n<text x=\"48\" y=\"151\" font-family=\"Segoe UI,Arial,sans-serif\" font-size=\"14\" font-weight=\"700\" fill=\"#9ab8cd\">PROCESS OVERVIEW</text>\n<text x=\"926\" y=\"151\" font-family=\"Segoe UI,Arial,sans-serif\" font-size=\"14\" font-weight=\"500\" fill=\"#9ab8cd\">Source: DoseProof Evidence API</text>\n<path d=\"M70 493L264 493L327 539L131 539Z\" fill=\"#0b1b2a\" stroke=\"#304b60\"/>\n<path d=\"M391 407L581 407L613 432L421 432Z\" fill=\"#0b1b2a\" stroke=\"#304b60\"/>\n<path d=\"M632 535L921 535L967 574L678 574Z\" fill=\"#0b1b2a\" stroke=\"#304b60\"/>\n<ellipse cx=\"780\" cy=\"532\" rx=\"144\" ry=\"40\" fill=\"#08131f\" opacity=\".77\"/>\n\n<path d=\"M91 482H661 M894 482H1164\" fill=\"none\" stroke=\"#06131f\" stroke-width=\"28\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n<path d=\"M91 482H661 M894 482H1164\" fill=\"none\" stroke=\"#4bd2df\" stroke-width=\"22\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n<path d=\"M514 350H590V482\" fill=\"none\" stroke=\"#06131f\" stroke-width=\"19\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n<path d=\"M514 350H590V482\" fill=\"none\" stroke=\"#f5b652\" stroke-width=\"13\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n<path d=\"M100 476H650 M898 476H1152\" stroke=\"#c3f6fb\" opacity=\".52\" stroke-width=\"3\" fill=\"none\"/>\n<path d=\"M250 471l16 11-16 11zM399 471l16 11-16 11zM1005 471l16 11-16 11zM1099 471l16 11-16 11z\" fill=\"#08364b\"/>\n<path d=\"M583 420l7 10 7-10z\" fill=\"#8a551a\"/>\n<circle cx=\"590\" cy=\"482\" r=\"9\" fill=\"#0f526b\" stroke=\"#c7f6ff\" stroke-width=\"2\"/>\n<path d=\"M91 451L142 451L159 463L108 463Z\" fill=\"#688ea5\"/>\n<path d=\"M91 451H108V506H91Z\" fill=\"#416883\"/>\n<path d=\"M108 463H159V506H108Z\" fill=\"url(#dp_metal)\" stroke=\"#27465c\"/>\n<ellipse cx=\"157\" cy=\"483\" rx=\"8\" ry=\"17\" fill=\"#234c63\" stroke=\"#8db8ca\"/>\n<path d=\"M1158 462h31v41h-31z\" fill=\"url(#dp_metal)\" stroke=\"#7a9bab\"/>\n<ellipse cx=\"1189\" cy=\"483\" rx=\"9\" ry=\"21\" fill=\"#123248\" stroke=\"#7a9bab\"/>\n<ellipse cx=\"1189\" cy=\"483\" rx=\"5\" ry=\"12\" fill=\"#4bd2df\"/>\n\n<path d=\"M323 272h65v103c0 15-65 15-65 0Z\" fill=\"url(#dp_metal)\" stroke=\"#a5bac7\"/>\n<ellipse cx=\"355.5\" cy=\"272\" rx=\"32.5\" ry=\"11\" fill=\"#8daabc\" stroke=\"#c6d8e0\"/>\n<path d=\"M331 310h49v31h-49z\" fill=\"#f7bd64\" opacity=\".86\"/>\n<path d=\"M390 351h34\" stroke=\"#f5b652\" stroke-width=\"10\"/>\n<path d=\"M418 365l30-16h81l-19 22v36h-92z\" fill=\"#122a41\" stroke=\"#476a81\"/>\n<path d=\"M429 324h60c18 0 24 17 24 32s-8 29-24 29h-60z\" fill=\"url(#dp_pump)\" stroke=\"#77bbde\"/>\n<path d=\"M438 330v48m10-48v48m10-48v48m10-48v48m10-48v48\" stroke=\"#a1d9f1\" opacity=\".58\" stroke-width=\"2\"/>\n<ellipse cx=\"492\" cy=\"354\" rx=\"26\" ry=\"29\" fill=\"url(#dp_pump)\" stroke=\"#9dd0e7\" stroke-width=\"2\"/>\n<ellipse cx=\"492\" cy=\"354\" rx=\"13\" ry=\"15\" fill=\"#19364f\" stroke=\"#73adcc\"/>\n<path d=\"M492 344v20m-9-10h18\" stroke=\"#a4d2e6\" stroke-width=\"2\"/>\n\n<text x=\"337\" y=\"331\" font-family=\"Segoe UI,Arial,sans-serif\" font-size=\"17\" font-weight=\"700\" fill=\"#382c21\">Cl</text>\n<text x=\"304\" y=\"402\" font-family=\"Segoe UI,Arial,sans-serif\" font-size=\"13\" font-weight=\"500\" fill=\"#e8bb78\">Chlorine feed</text>\n<text x=\"431\" y=\"425\" font-family=\"Segoe UI,Arial,sans-serif\" font-size=\"15\" font-weight=\"700\" fill=\"#dce9f5\">Dosing pump</text>\n<path d=\"M647 388V517c0 24 59 43 132 43s132-19 132-43V388Z\" fill=\"url(#dp_metal)\" stroke=\"#87a9bb\" stroke-width=\"2\"/>\n<path d=\"M670 423v82c0 18 48 34 109 34s109-16 109-34v-82Z\" fill=\"url(#dp_water)\" stroke=\"#abd1df\"/>\n<ellipse cx=\"779\" cy=\"423\" rx=\"109\" ry=\"31\" fill=\"#29aeb5\" stroke=\"#79e6e3\"/>\n<ellipse cx=\"779\" cy=\"388\" rx=\"132\" ry=\"39\" fill=\"#225775\" fill-opacity=\".5\" stroke=\"#b5d2df\" stroke-width=\"3\"/>\n<ellipse cx=\"779\" cy=\"387\" rx=\"119\" ry=\"32\" fill=\"none\" stroke=\"#7c9eaf\" stroke-width=\"2\"/>\n<path d=\"M688 458v51M869 458v5